# DB env ============================================================

# DB
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_HOST=
# DB_HOST=
DB_PORT=

# DATA API KEY
ONTONG_YOUTH_API_KEY=
LAW_API_KEY=
GOV24_API_KEY=

# ===================================================================

# Backend env =======================================================

TOKEN_SECRET=
# 관리자 계정. ADMIN_PASSWORD 가 비면 관리자 계정을 만들지 않는다(AWS 는 필수). ADMIN_EMAIL 기본값 admin@demo.com
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===================================================================

# LLM env ===========================================================

# Service
APP_NAME=
APP_ENV=
HOST=
PORT=
RELOAD=
LOG_LEVEL=
CORS_ORIGINS=

# OpenAI model identifiers and credential
LLM_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
COHERE_API_KEY=
COHERE_RERANK_MODEL=
COHERE_RERANK_CANDIDATE_K=
TAX_MAX_HOPS=
TAX_CACHE_ENABLED=
TAX_CACHE_SIMILARITY_THRESHOLD=
TAX_CACHE_DECISION_SIMILARITY_THRESHOLD=

# RAG indexing and search
CHUNK_SIZE=
CHUNK_OVERLAP=
DEFAULT_TOP_K=
MIN_RELEVANCE_SCORE=
RETRIEVAL_MODE=
HYBRID_DENSE_CANDIDATE_K=
HYBRID_BM25_CANDIDATE_K=
NORI_RETRIEVAL_POOL_K=40
HYBRID_RRF_K=
MAX_QUESTION_LENGTH=
MAX_CONTEXT_CHARACTERS=
MAX_CHUNKS_PER_POLICY=
RAG_ALLOWED_KEYWORDS=
RAG_BLOCKED_KEYWORDS=
OUT_OF_SCOPE_ANSWER=
VECTOR_INDEX_CACHE_PATH=

# Elasticsearch/Nori full reindex
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_ALIAS=
ELASTICSEARCH_REQUEST_TIMEOUT=
ELASTICSEARCH_BULK_CHUNK_SIZE=

# LangSmith tracing (disabled until explicitly enabled with a real API key)
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=

# ===================================================================

# Backend가 LLM을 기다리는 시간(초). Tax 멀티홉 질의는 25초를 넘길 수 있음
LLM_TIMEOUT_SECONDS=

# AWS env (docker-compose.app.yml / docker-compose.data.yml) ========
# 절차: Docs/AWS_DEPLOY_GUIDE.md

# App EC2: Data EC2 의 private IP (Postgres·Elasticsearch 가 함께 있다)
COMPOSE_DB_HOST=
COMPOSE_DB_PORT=5432
COMPOSE_ES_PORT=9200
# App EC2: 발표자료(/ppt/)도 띄울 때 presentation
COMPOSE_PROFILES=
# App EC2: main CI가 게시한 이미지. 자동 배포가 두 값을 해당 커밋으로 갱신한다.
APP_IMAGE_REGISTRY=ghcr.io/sknetworks-family-aicamp/skn34-4th-3team
APP_IMAGE_TAG=
# LLM은 운영 실측 후 한도를 반드시 지정한다(예: 측정에 맞는 2500m 또는 4g).
# 기존/신규 BM25 동시 보유, OCR, OS·다른 서비스 여유까지 포함해서 결정한다.
LLM_MEM_LIMIT=
# 아래 0은 제한 없음. 실측 후 서비스별 한도를 지정한다.
BACKEND_MEM_LIMIT=0
FRONTEND_MEM_LIMIT=0
PRESENTATION_MEM_LIMIT=0
COLLECTOR_MEM_LIMIT=0

# Data EC2: 이 인스턴스의 private IP (5432·9200 을 이 주소에만 연다)
DATA_BIND_IP=
# Data EC2: scripts/backup_db.sh 가 덤프를 올릴 S3 버킷 이름
BACKUP_BUCKET=
# 선택: 백업 실패/26시간 이상 미생성 시 SNS 알림. 구독 확인과 sns:Publish 권한 필요.
BACKUP_ALERT_TOPIC_ARN=

# ===================================================================
